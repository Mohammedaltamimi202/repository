                <button class="submit-btn" id="submitTransport">
                    <i class="fas fa-save"></i> حفظ بيانات هدر النقل
                </button>
            </div>
        </div>
        
        <!-- واجهة إدخال بيانات هدر الفرع -->
        <div class="waste-form-panel" id="branchWastePanel">
            <div class="waste-form">
                <div class="panel-header">
                    <h2>تسجيل هدر الفرع</h2>
                    <button class="back-btn" id="backFromBranch">
                        <i class="fas fa-arrow-left"></i> العودة
                    </button>
                </div>
                
                <h3>إضافة بيانات هدر الفرع</h3>
                
                <div class="photo-section">
                    <div class="photo-preview" id="branchPhotoPreview">
                        <i class="fas fa-camera" style="font-size: 3rem; color: #781f19;"></i>
                        <img id="branchPreviewImg" src="" alt="Preview">
                    </div>
                    
                    <div class="photo-options">
                        <button class="photo-btn" id="captureBranch">
                            <i class="fas fa-camera"></i> التقاط صورة
                        </button>
                        <button class="photo-btn" id="uploadBranch">
                            <i class="fas fa-upload"></i> إضافة من المعرض
                        </button>
                        <input type="file" id="branchFileInput" class="file-input" accept="image/*">
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-col">
                        <div class="form-group">
                            <label for="branchBranch">الفرع</label>
                            <select id="branchBranch">
                                <option value="">اختر فرع</option>
                                <!-- سيتم ملء الفروع تلقائياً -->
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-col">
                        <div class="form-group">
                            <label for="branchDate">التاريخ</label>
                            <input type="date" id="branchDate">
                        </div>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-col">
                        <div class="form-group">
                            <label for="branchQuantity">كمية الهدر</label>
                            <input type="number" id="branchQuantity" placeholder="الكمية بالوحدات">
                        </div>
                    </div>
                    
                    <div class="form-col">
                        <div class="form-group">
                            <label for="branchProduct">الصنف</label>
                            <select id="branchProduct">
                                <option value="">اختر صنف</option>
                                <option value="منتج 1">منتج 1</option>
                                <option value="منتج 2">منتج 2</option>
                                <option value="منتج 3">منتج 3</option>
                                <option value="منتج 4">منتج 4</option>
                            </select>
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="branchNotes">ملاحظات إضافية</label>
                    <textarea id="branchNotes" rows="3" placeholder="أي ملاحظات إضافية عن هدر الفرع"></textarea>
                </div>
                
                <button class="submit-btn" id="submitBranch">
                    <i class="fas fa-save"></i> حفظ بيانات هدر الفرع
                </button>
            </div>
        </div>
        
        <div class="footer">
            <p>نظام إدارة الطلبيات ومتابعة الهدر &copy; 2025 -Altam company</p>
        </div>
    </div>

    <script>
        // عناصر DOM
        const matchOrdersCard = document.getElementById('matchOrdersCard');
        const wasteTrackCard = document.getElementById('wasteTrackCard');
        const matchOrdersPanel = document.getElementById('matchOrdersPanel');
        const wasteTrackPanel = document.getElementById('wasteTrackPanel');
        const backFromOrders = document.getElementById('backFromOrders');
        const backFromWaste = document.getElementById('backFromWaste');
        const transportWaste = document.getElementById('transportWaste');
        const branchWaste = document.getElementById('branchWaste');
        const sentUploadBtn = document.getElementById('sentUploadBtn');
        const receivedUploadBtn = document.getElementById('receivedUploadBtn');
        const sentFileInput = document.getElementById('sentFileInput');
        const receivedFileInput = document.getElementById('receivedFileInput');
        const sentFileName = document.getElementById('sentFileName');
        const receivedFileName = document.getElementById('receivedFileName');
        const sentDetails = document.getElementById('sentDetails');
        const receivedDetails = document.getElementById('receivedDetails');
        const diffAlert = document.getElementById('diffAlert');
        const successAlert = document.getElementById('successAlert');
        const diffSection = document.getElementById('diffSection');
        const diffDetails = document.getElementById('diffDetails');
        const diffMessage = document.getElementById('diffMessage');
        const branchSelector = document.getElementById('branchSelector');
        const branchList = document.getElementById('branchList');
        
        // واجهات الهدر
        const transportWastePanel = document.getElementById('transportWastePanel');
        const branchWastePanel = document.getElementById('branchWastePanel');
        const backFromTransport = document.getElementById('backFromTransport');
        const backFromBranch = document.getElementById('backFromBranch');
        const captureTransport = document.getElementById('captureTransport');
        const uploadTransport = document.getElementById('uploadTransport');
        const transportFileInput = document.getElementById('transportFileInput');
        const transportPreviewImg = document.getElementById('transportPreviewImg');
        const captureBranch = document.getElementById('captureBranch');
        const uploadBranch = document.getElementById('uploadBranch');
        const branchFileInput = document.getElementById('branchFileInput');
        const branchPreviewImg = document.getElementById('branchPreviewImg');
        const submitTransport = document.getElementById('submitTransport');
        const submitBranch = document.getElementById('submitBranch');
        
        // تصدير البيانات
        const exportWasteData = document.getElementById('exportWasteData');
        const resetWasteData = document.getElementById('resetWasteData');
        const wasteSummary = document.getElementById('wasteSummary');
        
        // بيانات الطلبيات
        let sentOrderData = null; // بيانات جميع الفروع
        let receivedOrderData = null; // بيانات فرع واحد
        
        // تخزين بيانات الهدر
        let wasteData = {
            transport: [],
            branch: []
        };
        
        // قائمة الفروع الثابتة
        const predefinedBranches = [
            "النعيم",
            "الحمدانية",
            "السامر",
            "النسيم",
            "أبحر",
            "الصفاء",
            "السنابل",
            "الجال",
            "الشوقية"
        ];
        
        // تحميل البيانات من localStorage عند بدء التشغيل
        document.addEventListener('DOMContentLoaded', function() {
            const savedData = localStorage.getItem('wasteData');
            if (savedData) {
                wasteData = JSON.parse(savedData);
                updateWasteSummary();
            }
            
            // تهيئة قوائم الفروع
            populateBranchList();
            populateBranchSelectors();
        });
        
        // تعبئة قائمة الفروع
        function populateBranchList() {
            branchList.innerHTML = '';
            
            predefinedBranches.forEach(branch => {
                const branchItem = document.createElement('div');
                branchItem.className = 'branch-item';
                branchItem.innerHTML = `
                    <i class="fas fa-store"></i>
                    <h4>${branch}</h4>
                `;
                
                branchItem.addEventListener('click', () => {
                    branchSelector.value = branch;
                    if (sentOrderData && receivedOrderData) {
                        compareOrders();
                    }
                });
                
                branchList.appendChild(branchItem);
            });
        }
        
        // تعبئة قوائم الاختيار بالفروع
        function populateBranchSelectors() {
            // قائمة اختيار الفرع في واجهة المطابقة
            branchSelector.innerHTML = '<option value="">اختر فرع من القائمة</option>';
            predefinedBranches.forEach(branch => {
                const option = document.createElement('option');
                option.value = branch;
                option.textContent = branch;
                branchSelector.appendChild(option);
            });
            
            // قوائم اختيار الفرع في واجهات الهدر
            const transportBranch = document.getElementById('transportBranch');
            const branchBranch = document.getElementById('branchBranch');
            
            transportBranch.innerHTML = '<option value="">اختر فرع</option>';
            branchBranch.innerHTML = '<option value="">اختر فرع</option>';
            
            predefinedBranches.forEach(branch => {
                const option1 = document.createElement('option');
                option1.value = branch;
                option1.textContent = branch;
                transportBranch.appendChild(option1);
                
                const option2 = document.createElement('option');
                option2.value = branch;
                option2.textContent = branch;
                branchBranch.appendChild(option2);
            });
        }
        
        // أحداث النقر
        matchOrdersCard.addEventListener('click', () => {
            document.querySelector('.dashboard').style.display = 'none';
            matchOrdersPanel.style.display = 'block';
        });
        
        wasteTrackCard.addEventListener('click', () => {
            document.querySelector('.dashboard').style.display = 'none';
            wasteTrackPanel.style.display = 'block';
            updateWasteSummary();
        });
        
        backFromOrders.addEventListener('click', () => {
            matchOrdersPanel.style.display = 'none';
            document.querySelector('.dashboard').style.display = 'flex';
        });
        
        backFromWaste.addEventListener('click', () => {
            wasteTrackPanel.style.display = 'none';
            document.querySelector('.dashboard').style.display = 'flex';
        });
        
        transportWaste.addEventListener('click', () => {
            wasteTrackPanel.style.display = 'none';
            transportWastePanel.style.display = 'block';
            // تعيين التاريخ الحالي كقيمة افتراضية
            document.getElementById('transportDate').valueAsDate = new Date();
        });
        
        branchWaste.addEventListener('click', () => {
            wasteTrackPanel.style.display = 'none';
            branchWastePanel.style.display = 'block';
            // تعيين التاريخ الحالي كقيمة افتراضية
            document.getElementById('branchDate').valueAsDate = new Date();
        });
        
        backFromTransport.addEventListener('click', () => {
            transportWastePanel.style.display = 'none';
            wasteTrackPanel.style.display = 'block';
        });
        
        backFromBranch.addEventListener('click', () => {
            branchWastePanel.style.display = 'none';
            wasteTrackPanel.style.display = 'block';
        });
        
        // أحداث إضافة الصور
        uploadTransport.addEventListener('click', () => {
            transportFileInput.click();
        });
        
        transportFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    transportPreviewImg.src = event.target.result;
                    transportPreviewImg.style.display = 'block';
                    document.querySelector('#transportPhotoPreview i').style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        });
        
        uploadBranch.addEventListener('click', () => {
            branchFileInput.click();
        });
        
        branchFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    branchPreviewImg.src = event.target.result;
                    branchPreviewImg.style.display = 'block';
                    document.querySelector('#branchPhotoPreview i').style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        });
        
        // محاكاة التقاط الصورة (لأغراض العرض)
        captureTransport.addEventListener('click', function() {
            alert('في بيئة الإنتاج الحقيقية، سيتم فتح كاميرا الجهاز للتقاط صورة');
        });
        
        captureBranch.addEventListener('click', function() {
            alert('في بيئة الإنتاج الحقيقية، سيتم فتح كاميرا الجهاز للتقاط صورة');
        });
        
        // أحداث حفظ بيانات الهدر
        submitTransport.addEventListener('click', function() {
            const branch = document.getElementById('transportBranch').value;
            const date = document.getElementById('transportDate').value;
            const quantity = document.getElementById('transportQuantity').value;
            const product = document.getElementById('transportProduct').value;
            const notes = document.getElementById('transportNotes').value;
            
            if (!branch || !date || !quantity || !product) {
                alert('يرجى ملء جميع الحقول المطلوبة');
                return;
            }
            
            // حفظ بيانات هدر النقل
            const wasteItem = {
                type: 'نقل',
                branch: branch,
                date: date,
                quantity: quantity,
                product: product,
                notes: notes,
                timestamp: new Date().toISOString()
            };
            
            wasteData.transport.push(wasteItem);
            saveWasteData();
            
            alert(`تم حفظ بيانات هدر النقل بنجاح!\nالفرع: ${branch}\nالتاريخ: ${date}\nكمية الهدر: ${quantity}\nالصنف: ${product}`);
            
            // مسح الحقول بعد الحفظ
            document.getElementById('transportBranch').value = '';
            document.getElementById('transportQuantity').value = '';
            document.getElementById('transportProduct').selectedIndex = 0;
            document.getElementById('transportNotes').value = '';
            
            // إعادة تعيين الصورة
            transportPreviewImg.style.display = 'none';
            document.querySelector('#transportPhotoPreview i').style.display = 'block';
        });
        
        submitBranch.addEventListener('click', function() {
            const branch = document.getElementById('branchBranch').value;
            const date = document.getElementById('branchDate').value;
            const quantity = document.getElementById('branchQuantity').value;
            const product = document.getElementById('branchProduct').value;
            const notes = document.getElementById('branchNotes').value;
            
            if (!branch || !date || !quantity || !product) {
                alert('يرجى ملء جميع الحقول المطلوبة');
                return;
            }
            
            // حفظ بيانات هدر الفرع
            const wasteItem = {
                type: 'فرع',
                branch: branch,
                date: date,
                quantity: quantity,
                product: product,
                notes: notes,
                timestamp: new Date().toISOString()
            };
            
            wasteData.branch.push(wasteItem);
            saveWasteData();
            
            alert(`تم حفظ بيانات هدر الفرع بنجاح!\nالفرع: ${branch}\nالتاريخ: ${date}\nكمية الهدر: ${quantity}\nالصنف: ${product}`);
            
            // مسح الحقول بعد الحفظ
            document.getElementById('branchBranch').value = '';
            document.getElementById('branchQuantity').value = '';
            document.getElementById('branchProduct').selectedIndex = 0;
            document.getElementById('branchNotes').value = '';
            
            // إعادة تعيين الصورة
            branchPreviewImg.style.display = 'none';
            document.querySelector('#branchPhotoPreview i').style.display = 'block';
        });
        
        // تصدير بيانات الهدر
        exportWasteData.addEventListener('click', function() {
            if (wasteData.transport.length === 0 && wasteData.branch.length === 0) {
                alert('لا توجد بيانات هدر لتصديرها');
                return;
            }
            
            // إنشاء مصفوفة لجميع بيانات الهدر
            let allWasteData = [];
            
            // إضافة بيانات هدر النقل
            wasteData.transport.forEach(item => {
                allWasteData.push({
                    'النوع': 'هدر النقل',
                    'الفرع': item.branch,
                    'التاريخ': item.date,
                    'الصنف': item.product,
                    'الكمية': item.quantity,
                    'ملاحظات': item.notes,
                    'وقت التسجيل': new Date(item.timestamp).toLocaleString()
                });
            });
            
            // إضافة بيانات هدر الفرع
            wasteData.branch.forEach(item => {
                allWasteData.push({
                    'النوع': 'هدر الفرع',
                    'الفرع': item.branch,
                    'التاريخ': item.date,
                    'الصنف': item.product,
                    'الكمية': item.quantity,
                    'ملاحظات': item.notes,
                    'وقت التسجيل': new Date(item.timestamp).toLocaleString()
                });
            });
            
            // إنشاء مصنف Excel
            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.json_to_sheet(allWasteData);
            
            // إضافة ورقة العمل إلى المصنف
            XLSX.utils.book_append_sheet(wb, ws, 'بيانات الهدر');
            
            // تصدير الملف
            const fileName = `نظام_الهدر_${new Date().toISOString().slice(0,10)}.xlsx`;
            XLSX.writeFile(wb, fileName);
            
            alert(`تم تصدير ملف ${fileName} بنجاح`);
        });
        
        // مسح بيانات الهدر
        resetWasteData.addEventListener('click', function() {
            if (confirm('هل أنت متأكد من رغبتك في مسح جميع بيانات الهدر؟ لا يمكن التراجع عن هذا الإجراء.')) {
                wasteData = {
                    transport: [],
                    branch: []
                };
                saveWasteData();
                updateWasteSummary();
                alert('تم مسح جميع بيانات الهدر بنجاح');
            }
        });
        
        // حفظ البيانات في localStorage
        function saveWasteData() {
            localStorage.setItem('wasteData', JSON.stringify(wasteData));
            updateWasteSummary();
        }
        
        // تحديث ملخص بيانات الهدر
        function updateWasteSummary() {
            if (wasteData.transport.length === 0 && wasteData.branch.length === 0) {
                wasteSummary.innerHTML = '<p style="text-align: center; color: #888;">لا توجد بيانات مخزنة بعد</p>';
                return;
            }
            
            let html = '';
            
            // حساب إجمالي هدر النقل
            const transportTotal = wasteData.transport.reduce((sum, item) => sum + parseInt(item.quantity || 0), 0);
            html += `<div class="summary-item">
                        <span>عدد سجلات هدر النقل:</span>
                        <span>${wasteData.transport.length}</span>
                    </div>
                    <div class="summary-item">
                        <span>إجمالي هدر النقل:</span>
                        <span>${transportTotal} وحدة</span>
                    </div>`;
            
            // حساب إجمالي هدر الفرع
            const branchTotal = wasteData.branch.reduce((sum, item) => sum + parseInt(item.quantity || 0), 0);
            html += `<div class="summary-item">
                        <span>عدد سجلات هدر الفرع:</span>
                        <span>${wasteData.branch.length}</span>
                    </div>
                    <div class="summary-item">
                        <span>إجمالي هدر الفرع:</span>
                        <span>${branchTotal} وحدة</span>
                    </div>
                    <div class="summary-item">
                        <span>إجمالي الهدر الكلي:</span>
                        <span>${transportTotal + branchTotal} وحدة</span>
                    </div>
                    <div class="summary-item">
                        <span>تاريخ أحدث تسجيل:</span>
                        <span>${getLatestRecordDate()}</span>
                    </div>`;
            
            wasteSummary.innerHTML = html;
        }
        
        // الحصول على تاريخ أحدث تسجيل
        function getLatestRecordDate() {
            let latestDate = '';
            
            // البحث في هدر النقل
            wasteData.transport.forEach(item => {
                if (!latestDate || item.timestamp > latestDate) {
                    latestDate = item.timestamp;
                }
            });
            
            // البحث في هدر الفرع
            wasteData.branch.forEach(item => {
                if (!latestDate || item.timestamp > latestDate) {
                    latestDate = item.timestamp;
                }
            });
            
            return latestDate ? new Date(latestDate).toLocaleString() : 'لا يوجد سجلات';
        }
        
        // معالجة ملفات إكسل لمطابقة الطلبيات
        sentUploadBtn.addEventListener('click', () => {
            sentFileInput.click();
        });
        
        receivedUploadBtn.addEventListener('click', () => {
            receivedFileInput.click();
        });
        
        sentFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                sentFileName.textContent = file.name;
                readExcelFile(file, 'sent');
            }
        });
        
        receivedFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                receivedFileName.textContent = file.name;
                readExcelFile(file, 'received');
            }
        });
        
        function readExcelFile(file, type) {
            const reader = new FileReader();
            
            reader.onload = function(e) {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, { type: 'array' });
                
                // الحصول على الورقة الأولى
                const firstSheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[firstSheetName];
                
                // تحويل إلى JSON
                const jsonData = XLSX.utils.sheet_to_json(worksheet);
                
                if (type === 'sent') {
                    sentOrderData = jsonData;
                    displayOrderDetails(sentDetails, sentOrderData, 'جميع الفروع');
                } else {
                    receivedOrderData = jsonData;
                    displayOrderDetails(receivedDetails, receivedOrderData, 'فرع واحد');
                    
                    // إذا كان ملف الطلبية المرسلة قد تم تحميله، قم بالمطابقة
                    if (sentOrderData && branchSelector.value) {
                        compareOrders();
                    }
                }
            };
            
            reader.readAsArrayBuffer(file);
        }
        
        function displayOrderDetails(container, data, type) {
            if (!data || data.length === 0) {
                container.innerHTML = '<p style="color: #888; padding: 20px;">لا توجد بيانات لعرضها</p>';
                return;
            }
            
            let html = '';
            
            // عرض التفاصيل الأساسية للطلبية
            html += `<div class="detail">
                        <span>عدد العناصر:</span>
                        <span>${data.length}</span>
                    </div>`;
            
            // عرض أول 5 عناصر كمثال
            const sampleSize = Math.min(5, data.length);
            for (let i = 0; i < sampleSize; i++) {
                const item = data[i];
                html += `<div class="detail">
                            <span>${item['اسم المنتج'] || 'عنصر ' + (i+1)}:</span>
                            <span>${item['الكمية'] || 'غير محدد'} وحدة</span>
                        </div>`;
            }
            
            if (data.length > 5) {
                html += `<div class="detail">
                            <span>و ${data.length - 5} عناصر أخرى...</span>
                        </div>`;
            }
            
            container.innerHTML = html;
        }
        
        function compareOrders() {
            if (!sentOrderData || !receivedOrderData || !branchSelector.value) return;
            
            // مسح نتائج المقارنة السابقة
            diffDetails.innerHTML = '';
            diffAlert.style.display = 'none';
            successAlert.style.display = 'none';
            diffSection.style.display = 'none';
            
            const selectedBranch = branchSelector.value;
            
            // المقارنة البسيطة
            const sentTotal = sentOrderData.reduce((sum, item) => sum + (parseInt(item['الكمية']) || 0), 0);
            const receivedTotal = receivedOrderData.reduce((sum, item) => sum + (parseInt(item['الكمية']) || 0), 0);
            
            const diff = sentTotal - receivedTotal;
            
            if (diff > 0) {
                diffAlert.style.display = 'flex';
                diffSection.style.display = 'block';
                diffMessage.textContent = `تم اكتشاف نقص بمقدار ${diff} وحدة بين الطلبية المرسلة (${sentTotal} وحدة) والمستلمة (${receivedTotal} وحدة).`;
                
                // إضافة تفاصيل المقارنة
                diffDetails.innerHTML = `
                    <div class="diff-item">
                        <h4>الفرع المحدد</h4>
                        <p>${selectedBranch}</p>
                    </div>
                    <div class="diff-item">
                        <h4>الكمية الإجمالية المرسلة</h4>
                        <p>${sentTotal} وحدة</p>
                    </div>
                    <div class="diff-item">
                        <h4>الكمية الإجمالية المستلمة</h4>
                        <p>${receivedTotal} وحدة</p>
                    </div>
                    <div class="diff-item">
                        <h4>الفرق الكلي</h4>
                        <p>${diff} وحدة (نقص)</p>
                    </div>
                    <div class="diff-item">
                        <h4>نسبة النقص</h4>
                        <p>${((diff / sentTotal) * 100).toFixed(2)}%</p>
                    </div>
                `;
                
                // إرسال إشعارات
                sendNotifications(selectedBranch, sentTotal, receivedTotal, diff);
            } else if (diff < 0) {
                diffAlert.style.display = 'flex';
                diffSection.style.display = 'block';
                diffMessage.textContent = `تم اكتشاف زيادة بمقدار ${-diff} وحدة بين الطلبية المرسلة (${sentTotal} وحدة) والمستلمة (${receivedTotal} وحدة).`;
                
                // إضافة تفاصيل المقارنة
                diffDetails.innerHTML = `
                    <div class="diff-item">
                        <h4>الفرع المحدد</h4>
                        <p>${selectedBranch}</p>
                    </div>
                    <div class="diff-item">
                        <h4>الكمية الإجمالية المرسلة</h4>
                        <p>${sentTotal} وحدة</p>
                    </div>
                    <div class="diff-item">
                        <h4>الكمية الإجمالية المستلمة</h4>
                        <p>${receivedTotal} وحدة</p>
                    </div>
                    <div class="diff-item">
                        <h4>الفرق الكلي</h4>
                        <p>${-diff} وحدة (زيادة)</p>
                    </div>
                `;
            } else {
                successAlert.style.display = 'flex';
                document.getElementById('successMessage').innerHTML = `
                    تمت مطابقة طلبية فرع <strong>${selectedBranch}</strong> بنجاح بدون أي نقص
                `;
            }
        }
        
        // إرسال إشعارات عبر البريد الإلكتروني والواتساب
        function sendNotifications(branch, sent, received, diff) {
            const subject = `تحذير: نقص في طلبية فرع ${branch}`;
            const emailBody = `
                تم اكتشاف نقص في طلبية فرع ${branch}
                الكمية المرسلة: ${sent} وحدة
                الكمية المستلمة: ${received} وحدة
                النقص: ${diff} وحدة
                النسبة: ${((diff / sent) * 100).toFixed(2)}%
                التاريخ: ${new Date().toLocaleString()}
            `;
            
            const whatsappMessage = `تحذير: تم اكتشاف نقص في طلبية فرع ${branch}\nالكمية المرسلة: ${sent}\nالكمية المستلمة: ${received}\nالنقص: ${diff}\nالنسبة: ${((diff / sent) * 100).toFixed(2)}%`;
            
            // محاكاة إرسال البريد الإلكتروني
            console.log('إرسال بريد إلكتروني إلى: manager@example.com');
            console.log('الموضوع:', subject);
            console.log('المحتوى:', emailBody);
            
            // محاكاة إرسال رسالة واتساب
            console.log('إرسال رسالة واتساب إلى: +966500000000');
            console.log('المحتوى:', whatsappMessage);
            
            alert('تم إرسال إشعارات النقص إلى المدير المسؤول عبر البريد الإلكتروني والواتساب');
        }
    </script>
