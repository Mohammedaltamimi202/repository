<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة الطلبيات ومتابعة الهدر</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #781f19, #5a1612, #781f19);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            color: #333;
        }
        
        .container {
            width: 100%;
            max-width: 1400px;
            background-color: #fdf0f1;
            border-radius: 20px;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }
        
        header {
            background: linear-gradient(to right, #781f19, #5a1612);
            color: white;
            text-align: center;
            padding: 25px 20px;
            border-bottom: 5px solid #d4a5a2;
        }
        
        header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }
        
        header p {
            font-size: 1.2rem;
            opacity: 0.9;
        }
        
        .dashboard {
            display: flex;
            justify-content: space-around;
            padding: 40px 20px;
            flex-wrap: wrap;
            gap: 30px;
        }
        
        .card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            padding: 30px;
            text-align: center;
            width: 350px;
            transition: transform 0.3s, box-shadow 0.3s;
            cursor: pointer;
            border: 3px solid transparent;
        }
        
        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.2);
        }
        
        .card.match-orders {
            border-color: #781f19;
        }
        
        .card.waste-track {
            border-color: #5a1612;
        }
        
        .icon {
            font-size: 5rem;
            margin-bottom: 20px;
            color: #781f19;
        }
        
        .card h2 {
            font-size: 1.8rem;
            margin-bottom: 15px;
            color: #781f19;
        }
        
        .card p {
            font-size: 1.1rem;
            color: #555;
            line-height: 1.6;
        }
        
        .panel {
            padding: 30px;
            display: none;
            background: #fdf0f1;
            border-top: 2px solid #e8d1d3;
            animation: fadeIn 0.5s ease;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #781f19;
        }
        
        .panel-header h2 {
            font-size: 1.8rem;
            color: #781f19;
        }
        
        .back-btn {
            background: #781f19;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 30px;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .back-btn:hover {
            background: #5a1612;
        }
        
        .excel-upload-section {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 30px;
            margin-bottom: 20px;
        }
        
        .upload-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            padding: 30px;
            width: 450px;
            text-align: center;
            border: 2px dashed #781f19;
            transition: all 0.3s;
        }
        
        .upload-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }
        
        .upload-card h3 {
            font-size: 1.5rem;
            margin-bottom: 20px;
            color: #781f19;
        }
        
        .upload-icon {
            font-size: 4rem;
            color: #781f19;
            margin-bottom: 20px;
        }
        
        .file-input {
            display: none;
        }
        
        .upload-btn {
            background: #781f19;
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 30px;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-top: 15px;
        }
        
        .upload-btn:hover {
            background: #5a1612;
        }
        
        .file-name {
            margin-top: 15px;
            font-size: 0.9rem;
            color: #555;
            height: 20px;
        }
        
        .orders-container {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 30px;
            margin-bottom: 30px;
        }
        
        .order-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            padding: 25px;
            width: 350px;
            text-align: center;
            position: relative;
            overflow: hidden;
            border: 2px solid #781f19;
        }
        
        .order-card h3 {
            font-size: 1.5rem;
            margin-bottom: 20px;
            color: #781f19;
        }
        
        .order-details {
            text-align: right;
            margin-bottom: 20px;
            max-height: 300px;
            overflow-y: auto;
        }
        
        .detail {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px dashed #ddd;
        }
        
        .alert {
            background: #ffebee;
            color: #b71c1c;
            padding: 15px;
            border-radius: 10px;
            margin: 20px 0;
            border-left: 5px solid #b71c1c;
            display: flex;
            align-items: center;
            gap: 15px;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(183, 28, 28, 0.4); }
            70% { box-shadow: 0 0 0 15px rgba(183, 28, 28, 0); }
            100% { box-shadow: 0 0 0 0 rgba(183, 28, 28, 0); }
        }
        
        .alert i {
            font-size: 1.8rem;
        }
        
        .success {
            background: #e8f5e9;
            color: #1b5e20;
            padding: 15px;
            border-radius: 10px;
            margin: 20px 0;
            border-left: 5px solid #4caf50;
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .diff-section {
            margin-top: 40px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            padding: 25px;
            border: 2px solid #d4a5a2;
        }
        
        .diff-section h3 {
            font-size: 1.8rem;
            margin-bottom: 20px;
            color: #781f19;
            text-align: center;
        }
        
        .diff-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }
        
        .diff-item {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            border-left: 4px solid #5a1612;
        }
        
        .diff-item h4 {
            font-size: 1.2rem;
            margin-bottom: 10px;
            color: #5a1612;
        }
        
        .diff-item p {
            font-size: 1.1rem;
            line-height: 1.6;
        }
        
        .waste-options {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 30px;
        }
        
        .option-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            padding: 30px;
            text-align: center;
            transition: transform 0.3s;
            cursor: pointer;
            border: 2px solid #5a1612;
        }
        
        .option-card:hover {
            transform: translateY(-8px);
        }
        
        .option-card h3 {
            font-size: 1.5rem;
            margin-bottom: 15px;
            color: #5a1612;
        }
        
        .option-card i {
            font-size: 4rem;
            margin-bottom: 20px;
            color: #5a1612;
        }
        
        /* واجهة إدخال بيانات الهدر */
        .waste-form-panel {
            padding: 30px;
            display: none;
            background: #fdf0f1;
            border-top: 2px solid #e8d1d3;
            animation: fadeIn 0.5s ease;
        }
        
        .waste-form {
            background: white;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            padding: 30px;
            max-width: 800px;
            margin: 0 auto;
        }
        
        .waste-form h3 {
            text-align: center;
            font-size: 1.8rem;
            margin-bottom: 25px;
            color: #781f19;
        }
        
        .photo-section {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .photo-options {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
        }
        
        .photo-btn {
            background: #e8d1d3;
            color: #781f19;
            border: none;
            padding: 12px 25px;
            border-radius: 30px;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .photo-btn:hover {
            background: #d4a5a2;
        }
        
        .photo-preview {
            width: 200px;
            height: 200px;
            border: 2px dashed #781f19;
            border-radius: 10px;
            margin: 20px auto;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #fce4ec;
        }
        
        .photo-preview img {
            max-width: 100%;
            max-height: 100%;
            display: none;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #5a1612;
        }
        
        .form-group input, 
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e8d1d3;
            border-radius: 8px;
            font-size: 1rem;
            transition: border-color 0.3s;
        }
        
        .form-group input:focus, 
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: #781f19;
            outline: none;
        }
        
        .form-row {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }
        
        .form-col {
            flex: 1;
        }
        
        .submit-btn {
            background: #781f19;
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 30px;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background 0.3s;
            display: block;
            width: 100%;
            margin-top: 20px;
        }
        
        .submit-btn:hover {
            background: #5a1612;
        }
        
        .footer {
            text-align: center;
            padding: 20px;
            background: #781f19;
            color: white;
            font-size: 1rem;
            border-top: 5px solid #d4a5a2;
        }
        
        .export-section {
            text-align: center;
            padding: 20px;
            margin-top: 30px;
            border-top: 2px dashed #781f19;
        }
        
        .export-btn {
            background: #4CAF50;
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 30px;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin: 10px;
        }
        
        .export-btn:hover {
            background: #388E3C;
        }
        
        .reset-btn {
            background: #f44336;
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 30px;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin: 10px;
        }
        
        .reset-btn:hover {
            background: #d32f2f;
        }
        
        .data-summary {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin: 20px auto;
            max-width: 800px;
        }
        
        .data-summary h3 {
            text-align: center;
            color: #781f19;
            margin-bottom: 15px;
        }
        
        .summary-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #e8d1d3;
        }
        
        .branch-selector {
            margin: 20px 0;
            text-align: center;
        }
        
        .branch-selector select {
            padding: 10px 20px;
            border: 2px solid #781f19;
            border-radius: 30px;
            font-size: 1rem;
            background: white;
            color: #781f19;
            width: 300px;
            text-align: center;
            font-weight: bold;
        }
        
        .branch-selector select option {
            padding: 10px;
            text-align: center;
            background: #fdf0f1;
            color: #781f19;
        }
        
        .branch-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin: 20px 0;
            max-width: 800px;
            margin: 20px auto;
        }
        
        .branch-item {
            background: white;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            border: 2px solid #d4a5a2;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .branch-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
            background: #fce4ec;
        }
        
        .branch-item i {
            font-size: 2.5rem;
            color: #781f19;
            margin-bottom: 10px;
        }
        
        .branch-item h4 {
            color: #781f19;
            font-size: 1.2rem;
        }
        
        @media (max-width: 768px) {
            .card {
                width: 100%;
                max-width: 400px;
            }
            
            .upload-card {
                width: 100%;
            }
            
            .orders-container {
                flex-direction: column;
                align-items: center;
            }
            
            .form-row {
                flex-direction: column;
                gap: 10px;
            }
            
            .branch-list {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1> إدارة الطلبيات ومتابعة الهدر</h1>
            <p>   نفوذ الغربية   </p>
        </header>
        
        <div class="dashboard">
            <div class="card match-orders" id="matchOrdersCard">
                <div class="icon">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <h2>مطابقة الطلبيات</h2>
                <p>الضغط هنا لمطابقة الطلبيات المرسلة مع المستلمة والتحقق من وجود أي نقص</p>
            </div>
            
            <div class="card waste-track" id="wasteTrackCard">
                <div class="icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h2>متابعة الهدر</h2>
                <p>الضغط هنا لمتابعة الهدر وتصنيفه حسب النوع (هدر النقل، هدر الفرع)</p>
            </div>
        </div>
        
        <!-- مطابقة الطلبيات Panel -->
        <div class="panel" id="matchOrdersPanel">
            <div class="panel-header">
          </h2>  مطابقة الطلبيات </h2>
                <button class="back-btn" id="backFromOrders">
                    <i class="fas fa-arrow-left"></i> العودة للرئيسية
                </button>
            </div>
            
            <div class="excel-upload-section">
                <div class="upload-card">
                    <div class="upload-icon">
                        <i class="fas fa-file-excel"></i>
                    </div>
                    <h3>تحميل الطلبية المرسلة (جميع الفروع)</h3>
                    <p>يرجى تحميل ملف إكسل يحتوي على تفاصيل الطلبيات المرسلة لجميع الفروع</p>
                    <button class="upload-btn" id="sentUploadBtn">
                        <i class="fas fa-upload"></i> اختر ملف إكسل
                    </button>
                    <input type="file" id="sentFileInput" class="file-input" accept=".xlsx, .xls">
                    <div class="file-name" id="sentFileName"></div>
                </div>
                
                <div class="upload-card">
                    <div class="upload-icon">
                        <i class="fas fa-file-excel"></i>
                    </div>
                    <h3>تحميل الطلبية المستلمة (فرع واحد)</h3>
                    <p>يرجى تحميل ملف إكسل يحتوي على تفاصيل الطلبية المستلمة لفرع واحد</p>
                    <button class="upload-btn" id="receivedUploadBtn">
                        <i class="fas fa-upload"></i> اختر ملف إكسل
                    </button>
                    <input type="file" id="receivedFileInput" class="file-input" accept=".xlsx, .xls">
                    <div class="file-name" id="receivedFileName"></div>
                </div>
            </div>
            
            <div class="branch-selector">
                <h3>اختر الفرع للمطابقة</h3>
                <select id="branchSelector">
                    <option value="">اختر فرع من القائمة</option>
                </select>
            </div>
            
            <div class="branch-list" id="branchList">
                <!-- سيتم ملء هذا القسم بالفروع تلقائياً -->
            </div>
            
            <div class="orders-container">
                <div class="order-card">
                    <h3>تفاصيل الطلبية المرسلة (جميع الفروع)</h3>
                    <div class="order-details" id="sentDetails">
                        <p style="color: #888; padding: 20px;">لم يتم تحميل أي بيانات بعد</p>
                    </div>
                </div>
                
                <div class="order-card">
                    <h3>تفاصيل الطلبية المستلمة (فرع محدد)</h3>
                    <div class="order-details" id="receivedDetails">
                        <p style="color: #888; padding: 20px;">لم يتم تحميل أي بيانات بعد</p>
                    </div>
                </div>
            </div>
            
            <div id="diffAlert" class="alert" style="display: none;">
                <i class="fas fa-exclamation-triangle"></i>
                <div>
                    <h3>تحذير: يوجد فارق بين الطلبيتين!</h3>
                    <p id="diffMessage">تم اكتشاف فارق بين الطلبية المرسلة والمستلمة</p>
                </div>
            </div>
            
            <div id="successAlert" class="success" style="display: none;">
                <i class="fas fa-check-circle"></i>
                <div>
                    <h3>نجاح: الطلبية مطابقة!</h3>
                    <p id="successMessage">تمت مطابقة الطلبية بنجاح بدون أي نقص</p>
                </div>
            </div>
            
            <div class="diff-section" id="diffSection" style="display: none;">
                <h3>نتائج المقارنة</h3>
                <div class="diff-details" id="diffDetails">
                    <!-- سيتم ملء هذا القسم تلقائياً بعد المقارنة -->
                </div>
            </div>
        </div>
        
        <!-- متابعة الهدر Panel -->
        <div class="panel" id="wasteTrackPanel">
            <div class="panel-header">
                <h2>متابعة الهدر</h2>
                <button class="back-btn" id="backFromWaste">
                    <i class="fas fa-arrow-left"></i> العودة للرئيسية
                </button>
            </div>
            
            <div class="waste-options">
                <div class="option-card" id="transportWaste">
                    <i class="fas fa-truck"></i>
                    <h3>هدر النقل</h3>
                    <p>تتبع وتصنيف الهدر الناتج عن عمليات النقل والتوزيع</p>
                </div>
                
                <div class="option-card" id="branchWaste">
                    <i class="fas fa-store"></i>
                    <h3>هدر الفرع</h3>
                    <p>تتبع وتصنيف الهدر الناتج داخل الفروع </p>
                </div>
            </div>
            
            <div class="export-section">
                <button class="export-btn" id="exportWasteData">
                    <i class="fas fa-file-excel"></i> تصدير بيانات الهدر
                </button>
                <button class="reset-btn" id="resetWasteData">
                    <i class="fas fa-trash"></i> مسح جميع البيانات
                </button>
            </div>
            
            <div class="data-summary">
                <h3>ملخص البيانات المخزنة</h3>
                <div id="wasteSummary">
                    <p style="text-align: center; color: #888;">لا توجد بيانات مخزنة بعد</p>
                </div>
            </div>
        </div>
        
        <!-- واجهة إدخال بيانات هدر النقل -->
        <div class="waste-form-panel" id="transportWastePanel">
            <div class="waste-form">
                <div class="panel-header">
                    <h2>تسجيل هدر النقل</h2>
                    <button class="back-btn" id="backFromTransport">
                        <i class="fas fa-arrow-left"></i> العودة
                    </button>
                </div>
                
                <h3>إضافة بيانات هدر النقل</h3>
                
                <div class="photo-section">
                    <div class="photo-preview" id="transportPhotoPreview">
                        <i class="fas fa-camera" style="font-size: 3rem; color: #781f19;"></i>
                        <img id="transportPreviewImg" src="" alt="Preview">
                    </div>
                    
                    <div class="photo-options">
                        <button class="photo-btn" id="captureTransport">
                            <i class="fas fa-camera"></i> التقاط صورة
                        </button>
                        <button class="photo-btn" id="uploadTransport">
                            <i class="fas fa-upload"></i> إضافة من المعرض
                        </button>
                        <input type="file" id="transportFileInput" class="file-input" accept="image/*">
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-col">
                        <div class="form-group">
                            <label for="transportBranch">الفرع</label>
                            <select id="transportBranch">
                                <option value="">اختر فرع</option>
                                <!-- سيتم ملء الفروع تلقائياً -->
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-col">
                        <div class="form-group">
                            <label for="transportDate">التاريخ</label>
                            <input type="date" id="transportDate">
                        </div>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-col">
                        <div class="form-group">
                            <label for="transportQuantity">كمية الهدر</label>
                            <input type="number" id="transportQuantity" placeholder="الكمية بالوحدات">
                        </div>
                    </div>
                    
                    <div class="form-col">
                        <div class="form-group">
                            <label for="transportProduct">الصنف</label>
                            <select id="transportProduct">
                                <option value="">اختر صنف</option>
                                <option value="منتج 1">منتج 1</option>
                                <option value="منتج 2">منتج 2</option>
                                <option value="منتج 3">منتج 3</option>
                                <option value="منتج 4">منتج 4</option>
                            </select>
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="transportNotes">ملاحظات إضافية</label>
                    <textarea id="transportNotes" rows="3" placeholder="أي ملاحظات إضافية عن هدر النقل"></textarea>
